{
  "sections": [
    {
      "mood": {
        "type": "emoji",
        "required": true
      },
      "gratitude": {
        "type": "list",
        "required": false,
        "maxItems": 5
      },
      "sleep": {
        "type": "number",
        "required": true,
        "min": 0,
        "max": 24,
        "step": 0.5,
        "suffix": "hrs"
      },
      "weeklyGoals": {
        "type": "checkboxList",
        "scope": "week"
      },
      "todo": {
        "type": "checkboxList",
        "scope": "day"
      },
      "journal": {
        "type": "multilineText"
      }
    }
  ]
}
